# Salin fail ini ke .env dan isi nilai sebenar.
# DATABASE_URL: isi password postgres anda sebelum menjalankan server.
# Nota: jika password mengandungi aksara khas seperti #, +, @ atau !,
# ia mesti di-URL-encode (contoh: # -> %23, + -> %2B).
DATABASE_URL=postgresql+psycopg://postgres:GANTI_PASSWORD_ANDA@localhost:5432/sk_quiz
# TIMEZONE=Asia/Kuala_Lumpur